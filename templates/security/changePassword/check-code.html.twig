<!DOCTYPE html>
<html id="returning">
	<head>
		<meta charset="UTF-8">
		<title>
			{% block title %}Photographie de mariages
			{% endblock %}
		</title>
		<link rel="icon" href="{{asset("imgs/favicon.png")}}">
		<link rel="stylesheet" href="{{asset("styles/base.css")}}">
		<link rel="stylesheet" href="{{asset("styles/header.css")}}">
		<link rel="stylesheet" href="{{asset("styles/signupPage/signup.css")}}">

		<meta name="viewport" content="width=device-width, initial-scale=1.0"> {% block stylesheets %}{% endblock %}{% block javascripts %}{% endblock %}
		</head>
	</html>


	{% block body %}
		{% include "header.html.twig" %}
		<main>
			<div class="form-container">
				<form action="/change-password">
                    <p>Saississez le code qui a été envoyé sur votre email </p>
                    <input name="change_password_code" type="text"/>
					<input type="hidden" name="csrf_token" value="{{csrfToken}}"/>
                </form>
			</div>
			</div>
		</main>
		<script src="{{asset("scripts/header.js")}}"></script>
		<script src="{{asset("scripts/signupPage/signup.js")}}"></script>

	{% endblock %}
