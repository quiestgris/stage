<!DOCTYPE html>
<html id="returning">
	<head>
		<meta charset="UTF-8">
		<title>
			{% block title %}Photographie
			{% endblock %}
		</title>
		<link rel="icon" href="{{asset("imgs/favicon.png")}}">
		<link rel="stylesheet" href="{{asset("styles/header.css")}}">
		<link rel="stylesheet" href="{{asset("styles/footer.css")}}">
		<link rel="stylesheet" href="{{asset("styles/portfolioPage/portfolio.css")}}">
		<link rel="stylesheet" href="{{asset("styles/base.css")}}">
		<meta name="viewport" content="width=device-width, initial-scale=1.0"> {% block stylesheets %}{% endblock %}{% block javascripts %}{% endblock %}
		</head>
		<body>
			<div class="bg-gray hide"></div>
			{% include "header.html.twig" %}
			<main>
				<div class="content-container">
					<section class="portfolio-section">
						<h1>Portfolio</h1>
						<div class="portfolio-imgs">
							{% for img in imgs %}
								
								<div class="portfolio-img-container">
									<div class="open-portfolio-img-container hide">
										<div class="flex-justify-content-right">
											<button class="open-portfolio-img-close-btn">
												<div class="cross">
													<div class="cross-line"></div>
													<div class="cross-line reverse"></div>
												</div>
											</button>
										</div>
										<div class="open-portfolio-img-content">
											
											<div class="open-portfolio-img-arrow"></div>
											<div class="open-portfolio-img-carrousel">
												{% for carrouselImg in imgs %}
										
														{% if carrouselImg.src == img.src %}
															{% set restItems = true %}
														{% endif %}
														{% if restItems == false %}
															<img class="open-portfolio-img" loading="lazy" src="{{asset(carrouselImg.src)}}" alt="Photo de travail précédent">
														{% endif %}
												{% endfor %}
												{% set restItems = false %}
													<img class="open-portfolio-img current" loading="lazy" src="{{asset(img.src)}}" alt="Photo de travail précédent">
												{% for carrouselImg in imgs %}
														{% if carrouselImg.src == img.src %}
															{% set restItems = true %}
														{% endif %}
														{% if loop.last %}
															{% set restItems = false %}
															<img class="open-portfolio-img" loading="lazy" src="{{asset(carrouselImg.src)}}" alt="Photo de travail précédent">
														{% endif %}
														{% if restItems == true %}
															<img class="open-portfolio-img" loading="lazy" src="{{asset(carrouselImg.src)}}" alt="Photo de travail précédent">
														{% endif %}
												{% endfor %}	
											</div>
											<div class="open-portfolio-img-arrow reverse"></div>
										</div>
									</div>
									<img src="{{asset(img.src)}}" alt="Photo de travail précédent">
									<div class="portfolio-img-bg"></div>
								</div>
							{% endfor %}
						</div>
					</section>
				</div>
			</main>
			{% include "footer.html.twig" %}
			<script src="{{asset("scripts/header.js")}}"></script>
			<script src="{{asset("scripts/base.js")}}"></script>
			<script src="{{asset("scripts/portfolioPage/portfolioPage.js")}}"></script>
		</body>

	</html>
